{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "central-de-contatos/lista-contatos",
  "version": "0.1.2",
  "title": "Lista de Contatos",
  "category": "widgets",
  "icon": "id",
  "description": "Liste todos os contatos da sua lista",
  "example": {
    "attributes": {
      "quantidade": 2
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    }
  },

  "textdomain": "central-de-contatos",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "attributes": {
    "quantidade": {
      "type": "integer",
      "default": 5
    },
    "ordenacao": {
      "type": "string",
      "default": "title",
      "enum": ["title", "date"]
    },
    "mostrar_email": {
      "type": "boolean",
      "default": true
    }
  },
  "render": "file:./render.php"
}
